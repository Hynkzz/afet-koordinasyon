{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sinyal.schema.json",
  "title": "Sinyal",
  "description": "Bir mesh dugumunun baglanti kalitesi olcumu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dugum_id", "rssi", "paket_alim_orani", "zaman"],
  "properties": {
    "dugum_id": { "type": "string", "minLength": 1, "maxLength": 32 },
    "rssi": { "description": "dBm cinsinden.", "type": "number", "minimum": -120, "maximum": 0 },
    "paket_alim_orani": { "type": "number", "minimum": 0, "maximum": 1 },
    "zaman": { "type": "string", "format": "date-time" }
  },
  "examples": [
    { "dugum_id": "d3", "rssi": -71, "paket_alim_orani": 0.92, "zaman": "2026-10-29T14:03:10+03:00" }
  ]
}
