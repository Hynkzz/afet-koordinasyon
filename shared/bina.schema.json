{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bina.schema.json",
  "title": "Binalar",
  "description": "Bina katmaninin kaynagi (GeoJSON FeatureCollection). Her Feature bir Polygon; koordinat sirasi [boylam, enlem].",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "kaynak": { "description": "Veri atfi, or. \"OpenStreetMap katkicilari, ODbL\".", "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Polygon" },
              "coordinates": {
                "description": "Halka listesi; ilk halka dis cerceve, ilk nokta son noktayla aynidir.",
                "type": "array", "minItems": 1,
                "items": {
                  "type": "array", "minItems": 4,
                  "items": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "prefixItems": [
                      { "type": "number", "minimum": -180, "maximum": 180 },
                      { "type": "number", "minimum": -90, "maximum": 90 }
                    ]
                  }
                }
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["id", "yukseklik_m", "yukseklik_kaynak"],
            "properties": {
              "id": { "description": "Tekil bina kimligi; bina_olayi.schema.json'daki bina_id ile ayni.", "type": "string", "minLength": 1, "maxLength": 64 },
              "yukseklik_m": { "type": "number", "minimum": 0 },
              "kat": { "description": "Biliniyorsa kat sayisi.", "type": ["integer", "null"], "minimum": 0 },
              "yukseklik_kaynak": { "enum": ["osm_yukseklik", "osm_kat", "overture_yukseklik", "overture_kat", "tahmin"] },
              "kaynak_veri": { "description": "Sinirin kaynagi: OSM ya da Microsoft ML Buildings (Overture uzerinden).", "enum": ["osm", "microsoft"] },
              "adres": { "type": ["string", "null"] },
              "ad": { "type": ["string", "null"] },
              "tur": { "description": "OSM building degeri, or. \"apartments\".", "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "type": "FeatureCollection",
      "kaynak": "OpenStreetMap katkicilari, ODbL",
      "features": [
        {"type": "Feature",
         "geometry": {"type": "Polygon", "coordinates": [[[34.824229, 39.8251225], [34.8240327, 39.825255], [34.8241635, 39.8253509], [34.824229, 39.8251225]]]},
         "properties": {"id": "w90138310", "yukseklik_m": 12.0, "kat": 4, "yukseklik_kaynak": "tahmin", "adres": null, "ad": null, "tur": "apartments"}}
      ]
    }
  ]
}