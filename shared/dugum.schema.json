{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dugum.schema.json",
  "title": "Dugumler ve sensorler",
  "description": "Mesh dugumlerinin, kameranin ve mikrofonun yerlesimi (GeoJSON FeatureCollection). Koordinat sirasi [boylam, enlem].",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ]
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["id", "tur", "kaynak"],
            "properties": {
              "id": { "description": "Dugumde sinyal.schema.json'daki dugum_id ile ayni.", "type": "string", "minLength": 1, "maxLength": 32 },
              "tur": { "enum": ["dugum", "kamera", "mikrofon"] },
              "menzil_m": { "description": "Yalnizca dugum: kapsama yaricapi, metre.", "type": "number", "exclusiveMinimum": 0 },
              "kaynak": { "enum": ["olcum", "hesap", "tahmin"] }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "type": "FeatureCollection",
      "features": [
        {"type": "Feature", "geometry": {"type": "Point", "coordinates": [34.8085, 39.8188]}, "properties": {"id": "d1", "tur": "dugum", "menzil_m": 80, "kaynak": "hesap"}},
        {"type": "Feature", "geometry": {"type": "Point", "coordinates": [34.8105, 39.8172]}, "properties": {"id": "kamera1", "tur": "kamera", "kaynak": "tahmin"}}
      ]
    }
  ]
}
